# Serves the web app and proxies the API (REST + WebSocket) on one origin. SITE_ADDRESS is $DOMAIN
# by default (automatic HTTPS); behind your own proxy it is `:80` (plain HTTP, no certificates),
# see docs/DEPLOY.md. Caddy replaces any X-Forwarded-For from untrusted peers, so the API trusts
# one hop (TRUST_PROXY=1); with TRUSTED_PROXIES covering the outer proxy, its header is kept and
# the API trusts two (TRUST_PROXY=2).
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	header -Server

	# API, Swagger (when API_DOCS=true) and the realtime socket at /api/v1/ws. The API sets its
	# own security headers (helmet, and a sandbox CSP on attachment downloads), so none are
	# added here.
	handle /api/* {
		request_body {
			max_size 30MB
		}
		reverse_proxy api:3000
	}

	# The single-page app: real files, else index.html for client routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Cross-Origin-Opener-Policy "same-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			# Fonts come from Google Fonts; the editor (TipTap) injects a <style> element.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' wss://{host}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}
		# Hashed build assets never change; everything else is revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		# The web app manifest (Add to Home Screen) under its registered type.
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
	}
}
