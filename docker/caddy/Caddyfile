# Serves the web app and proxies the API (REST + WebSocket) on one origin. SITE_ADDRESS is $DOMAIN
# by default (automatic HTTPS); behind your own proxy it is `:80` (plain HTTP, no certificates),
# see docs/DEPLOY.md. Caddy replaces any X-Forwarded-For from untrusted peers, so the API trusts
# one hop (TRUST_PROXY=1); with TRUSTED_PROXIES covering the outer proxy, its header is kept and
# the API trusts two (TRUST_PROXY=2).
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	header -Server

	# API, Swagger (when API_DOCS=true) and the realtime socket at /api/v1/ws. The API sets its
	# own security headers (helmet, and a sandbox CSP on attachment downloads), so none are
	# added here.
	handle /api/* {
		request_body {
			max_size 30MB
		}
		reverse_proxy api:3000
	}

	# The remote Claude connector (when the `connector` profile runs): the MCP endpoint, and the
	# OAuth metadata documents clients look for under /.well-known (RFC 9728, RFC 8414; with a
	# sub-path the outer proxy sends the host-root forms here too, see docs/DEPLOY.md). Without
	# these the paths would fall through to the app's index.html.
	@mcp path /mcp /mcp/
	handle @mcp {
		request_body {
			max_size 1MB
		}
		reverse_proxy mcp:3001
	}
	@oauth_resource path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @oauth_resource {
		rewrite * /api/v1/oauth/resource-metadata
		reverse_proxy api:3000
	}
	@oauth_server path /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/* /.well-known/openid-configuration /.well-known/openid-configuration/*
	handle @oauth_server {
		rewrite * /api/v1/oauth/metadata
		reverse_proxy api:3000
	}

	# The single-page app: real files, else index.html for client routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			# Fonts come from Google Fonts; the editor (TipTap) injects a <style> element.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' wss://{host}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}
		# Every page is isolated from windows of other sites, except the connector's consent
		# page: Claude opens it in its own window and it ends by going back to Claude's callback.
		# `same-origin` there would cut that window off from the one that opened it for good, so
		# the callback could not report back. Framing stays forbidden (X-Frame-Options, CSP).
		@isolated not path /oauth/authorize
		header @isolated Cross-Origin-Opener-Policy "same-origin"
		# Hashed build assets never change; everything else is revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		# The web app manifest (Add to Home Screen) under its registered type.
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
	}
}
