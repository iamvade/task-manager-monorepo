# Required: development | test | production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# docker compose publishes Postgres on POSTGRES_PORT (root .env, default 5432).
# If a local Postgres already uses 5432, set POSTGRES_PORT=5433 and use 5433 below.
DATABASE_URL=postgres://kite:kite@localhost:5432/kite
TEST_DATABASE_URL=postgres://kite:kite@localhost:5432/kite_test

# Origin of the web app (CORS + CSRF origin checks). With https the session cookie is Secure.
WEB_ORIGIN=http://localhost:5173

# Reverse proxy in front of the API (per-IP rate limits read X-Forwarded-For):
#   false            no proxy; the socket address is the client
#   1                trust the nearest proxy only (one nginx/Caddy/load balancer in front)
#   10.0.0.0/8,...   trust these proxy addresses/CIDRs
#   true             trust every hop: only if the API is unreachable except through the proxy
TRUST_PROXY=false

# OpenAPI spec + Swagger UI at /api/docs. Unset = on everywhere except NODE_ENV=production.
# API_DOCS=true

# Attachment files (local disk). Relative to apps/api. Max upload size in bytes (default 25 MB).
UPLOADS_DIR=uploads
# MAX_UPLOAD_BYTES=26214400
# Total attachment storage per workspace in bytes (default 5 GiB).
# MAX_WORKSPACE_STORAGE_BYTES=5368709120
# How long computed reports are reused, ms (0 = no cache).
# REPORTS_CACHE_TTL_MS=300000

# Seed (pnpm db:seed / db:reset). Language of user content that the designs have in mn and en.
SEED_LANG=mn
# Pin "today" (YYYY-MM-DD) for the seed; Oct 8 2026 is the day the designs show.
# SEED_TODAY=2026-10-08
