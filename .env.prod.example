# Production settings for docker-compose.prod.yml. On the server: cp .env.prod.example .env
# and fill in the values below. Never commit the real .env.

# Lets plain `docker compose …` use the production file.
COMPOSE_FILE=docker-compose.prod.yml

# Public host name (DNS A/AAAA record pointing at this server). Caddy gets the certificate.
DOMAIN=tasks.example.mn
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=ops@example.mn
# Serve the app under a path of DOMAIN (e.g. /tasks) instead of its root. Only for running
# behind your own reverse proxy (docs/DEPLOY.md, "Behind an existing nginx"); the bundled
# Caddy serves the root. Empty = root.
BASE_PATH=

# Database password. Generate with: openssl rand -hex 24 (hex keeps the connection URL valid).
POSTGRES_PASSWORD=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Swagger UI at /api/docs (off in production unless true).
API_DOCS=false

# Daily backups into ./backups at BACKUP_TIME in TZ, kept for BACKUP_KEEP_DAYS days.
TZ=Asia/Ulaanbaatar
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14

# Attachment files: local (Docker volume "uploads", included in backups) or s3.
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# For Cloudflare R2 / other S3-compatible services:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Per-workspace attachment quota in bytes (default 5 GiB).
# MAX_WORKSPACE_STORAGE_BYTES=5368709120

# Image tag for kite-api / kite-web (e.g. a git tag, for easy rollback).
# KITE_TAG=latest
