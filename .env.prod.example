# Production settings for docker-compose.prod.yml. On the server: cp .env.prod.example .env
# and fill in the values below. Never commit the real .env.

# Lets plain `docker compose …` use the production file.
COMPOSE_FILE=docker-compose.prod.yml

# Public host name (DNS A/AAAA record pointing at this server). Caddy gets the certificate.
DOMAIN=tasks.example.mn
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=ops@example.mn

# Behind an existing nginx (it owns 80/443) under a sub-path, e.g.
# https://staging.api.shoppyhub.mn/task-manager: see docs/DEPLOY.md "Behind an existing nginx".
# BASE_PATH=/task-manager             # baked into the web build; WEB_ORIGIN becomes https://$DOMAIN$BASE_PATH
# SITE_ADDRESS=:80                    # Caddy: plain HTTP, no certificates
# HTTP_BIND=127.0.0.1:8080            # only nginx on this host can reach it
# HTTPS_BIND=127.0.0.1:8443           # unused, just off 443
# TRUSTED_PROXIES=private_ranges      # nginx reaches Caddy via Docker's bridge gateway (172.x)
# TRUST_PROXY=2                       # the API trusts nginx + Caddy: real client IP for the login throttle

# Database password. Generate with: openssl rand -hex 24 (hex keeps the connection URL valid).
POSTGRES_PASSWORD=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Swagger UI at /api/docs (off in production unless true).
API_DOCS=false

# Daily backups into ./backups at BACKUP_TIME in TZ, kept for BACKUP_KEEP_DAYS days.
TZ=Asia/Ulaanbaatar
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14

# Attachment files: local (Docker volume "uploads", included in backups) or s3.
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# For Cloudflare R2 / other S3-compatible services:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Per-workspace attachment quota in bytes (default 5 GiB).
# MAX_WORKSPACE_STORAGE_BYTES=5368709120

# Web Push notifications (browser notifications while Kite is closed). All three or none
# (none = the Settings switch is hidden). Generate the key pair once, after the first build:
#   docker compose run --rm api node dist/scripts/push-keys.js
# VAPID_SUBJECT is a contact for the push services: mailto:you@example.mn or an https URL.
# Keep the pair: a new one makes every browser turn push on again. The private key is a secret.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.mn

# Remote Claude connector: people add https://$DOMAIN$BASE_PATH/mcp in Claude (Customize →
# Connectors → Add custom connector) and sign in with their Kite account. Needs public HTTPS
# reachable from Anthropic's servers over IPv4. Both lines together; see docs/DEPLOY.md.
# COMPOSE_PROFILES=connector          # runs the `mcp` service
# CONNECTOR_ENABLED=true              # the API's OAuth routes
# Under a sub-path also add the /.well-known locations from docker/nginx/kite-subpath.conf.

# Image tag for kite-api / kite-web (e.g. a git tag, for easy rollback).
# KITE_TAG=latest
