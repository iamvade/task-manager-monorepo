{
  "name": "kite-tasks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kite/api --filter @kite/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @kite/web test:e2e",
    "db:generate": "pnpm --filter @kite/api db:generate",
    "db:migrate": "pnpm --filter @kite/api db:migrate",
    "db:seed": "pnpm --filter @kite/api db:seed",
    "db:reset": "pnpm --filter @kite/api db:reset",
    "db:vade": "pnpm --filter @kite/api db:vade",
    "db:reset:demo": "pnpm --filter @kite/api db:reset:demo",
    "db:print": "pnpm --filter @kite/api db:print",
    "db:waits": "pnpm --filter @kite/api db:waits",
    "db:perf": "pnpm --filter @kite/api db:perf",
    "db:scenario": "pnpm --filter @kite/api db:scenario"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
